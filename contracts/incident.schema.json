{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smart112.gov/schemas/incident.schema.json",
  "title": "Smart112Incident",
  "description": "Authoritative contract schema representing an emergency 112 incident record.",
  "type": "object",
  "required": [
    "id",
    "incident_number",
    "category",
    "severity_level",
    "status",
    "coordinates",
    "created_at",
    "updated_at",
    "requires_human_review"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the incident."
    },
    "incident_number": {
      "type": "string",
      "description": "Human-readable sequential incident number (e.g. INC-2026-0001)."
    },
    "raw_text": {
      "type": "string",
      "description": "Raw or transcribed text provided by the caller."
    },
    "caller_text": {
      "type": "string",
      "description": "Alias for raw caller text."
    },
    "caller_phone": {
      "type": "string",
      "description": "Contact telephone number of the caller if available."
    },
    "category": {
      "type": "string",
      "enum": [
        "MEDICAL",
        "FIRE",
        "POLICE",
        "TRAFFIC_ACCIDENT",
        "HAZMAT",
        "NATURAL_DISASTER",
        "RESCUE",
        "UNKNOWN",
        "OTHER"
      ],
      "description": "High-level classification of the emergency service domain."
    },
    "severity_level": {
      "type": "string",
      "enum": [
        "LEVEL_1_CRITICAL",
        "LEVEL_2_HIGH",
        "LEVEL_3_MODERATE",
        "LEVEL_4_LOW",
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "UNKNOWN"
      ],
      "description": "Calculated emergency triage severity level. Client calculation forbidden."
    },
    "status": {
      "type": "string",
      "enum": [
        "REPORTED",
        "ASSESSED",
        "RECOMMENDED",
        "DISPATCHED",
        "ON_SCENE",
        "RESOLVED",
        "CANCELLED"
      ],
      "description": "Current lifecycle state of the emergency incident."
    },
    "coordinates": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "additionalProperties": true,
      "description": "Geographic coordinates of the emergency location.",
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90.0,
          "maximum": 90.0,
          "description": "WGS84 Latitude coordinate."
        },
        "longitude": {
          "type": "number",
          "minimum": -180.0,
          "maximum": 180.0,
          "description": "WGS84 Longitude coordinate."
        },
        "address": {
          "type": "string",
          "description": "Street address or human-readable description."
        },
        "landmark": {
          "type": "string",
          "description": "Nearby landmark or descriptive reference point."
        }
      }
    },
    "requires_human_review": {
      "type": "boolean",
      "default": false,
      "description": "Mandatory flag indicating whether a human dispatcher must manually verify triage/AI inference."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of incident ingestion."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 UTC timestamp of last incident modification."
    }
  }
}
